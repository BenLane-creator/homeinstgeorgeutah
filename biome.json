{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/.astro",
			"!**/.wrangler",
			"!**/.vite",
			"!**/.cache",
			"!**/.mf",
			"!**/coverage",
			"!**/playwright-report",
			"!**/test-results",
			"!**/*.astro"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true
	},
	"assist": {
		"enabled": true
	}
}
