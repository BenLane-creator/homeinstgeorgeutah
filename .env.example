# HomeInStGeorgeUtah.com custom Cloudflare build
PUBLIC_SITE_URL=https://homeinstgeorgeutah.com
PUBLIC_SITE_NAME="Home In St. George"
PUBLIC_MARKET="Southern Utah"
PUBLIC_CONTACT_PHONE="(435) 773-1220"
PUBLIC_CONTACT_EMAIL=joel@homeinstgeorgeutah.com

# Keep the site out of search results until launch approval.
# Set to false only for the approved production launch.
PUBLIC_PRELAUNCH=true

# Existing Cloudflare Turnstile widget. The sitekey is public; keep the secret out of this file.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEBRnBXOhm-2N05o
TURNSTILE_HOSTNAMES=homeinstgeorgeutah.com,www.homeinstgeorgeutah.com
TURNSTILE_EXPECTED_ACTION=turnstile-spin-v2
# Secret: TURNSTILE_SECRET_KEY

# Washington County IDX. Keep pending and disabled until the MLS approval,
# signed policy/version record, production feed, and credentials are complete.
WASHINGTON_IDX_APPROVAL_STATUS=pending
WASHINGTON_IDX_ENABLED=false
WASHINGTON_IDX_POLICY_VERSION=
WASHINGTON_IDX_PROVIDER=
WASHINGTON_IDX_API_BASE_URL=
# Secret: WASHINGTON_IDX_ACCESS_TOKEN

# Washington County VOW. Keep disabled until approval, policy encoding,
# production OAuth endpoints, the current-contact endpoint, and credentials exist.
WASHINGTON_VOW_APPROVAL_STATUS=pending
WASHINGTON_VOW_ENABLED=false
WASHINGTON_VOW_POLICY_VERSION=
WASHINGTON_VOW_CLIENT_ID=
WASHINGTON_VOW_AUTHORIZATION_URL=
WASHINGTON_VOW_TOKEN_URL=
WASHINGTON_VOW_CONTACT_URL=
WASHINGTON_VOW_MLS_ID=
# Secret: WASHINGTON_VOW_CLIENT_SECRET

# Iron County IDX. This is a separate subscription, approval, feed, policy,
# activation switch, and kill switch from Washington County.
IRON_IDX_APPROVAL_STATUS=pending
IRON_IDX_ENABLED=false
IRON_IDX_POLICY_VERSION=
IRON_IDX_PROVIDER=
IRON_IDX_API_BASE_URL=
# Secret: IRON_IDX_ACCESS_TOKEN

# Iron County VOW. This is independently approved and activated.
IRON_VOW_APPROVAL_STATUS=pending
IRON_VOW_ENABLED=false
IRON_VOW_POLICY_VERSION=
IRON_VOW_CLIENT_ID=
IRON_VOW_AUTHORIZATION_URL=
IRON_VOW_TOKEN_URL=
IRON_VOW_CONTACT_URL=
IRON_VOW_MLS_ID=
# Secret: IRON_VOW_CLIENT_SECRET

# Shared registered callback. State and provider tokens remain server-side.
VOW_REDIRECT_URI=https://homeinstgeorgeutah.com/api/v1/auth/flexmls/callback
# Secret: VOW_STATE_SECRET
# Secret: VOW_TOKEN_ENCRYPTION_KEY (strong 32+ character secret)

# API security
APP_ENV=development
API_WRITE_ORIGINS=https://homeinstgeorgeutah.com,https://www.homeinstgeorgeutah.com,http://localhost:4321,http://localhost:8787
# Secret used only by protected internal sync/recovery routes.
# INTERNAL_JOB_TOKEN=

# Owned notification outbox. D1 remains canonical; the API delivers through
# the internal Cloudflare Service Binding configured in apps/api/wrangler.toml.
OWNER_NOTIFICATION_EMAIL=joel@homeinstgeorge.com

# Cloudflare D1 is the source of truth for operational state.
# Configure the DB binding in apps/api/wrangler.toml.

# Optional downstream utilities only. They must not own canonical records or routing logic.
CRM_WEBHOOK_URL=
BOOKING_HANDOFF_URL=
SMS_DELIVERY_WEBHOOK_URL=
