# HomeInStGeorgeUtah.com custom Cloudflare build
PUBLIC_SITE_URL=https://homeinstgeorgeutah.com
PUBLIC_SITE_NAME="Home In St. George"
PUBLIC_MARKET="St. George & Southern Utah"
PUBLIC_CONTACT_PHONE="(435) 773-1220"
PUBLIC_CONTACT_EMAIL=joel@homeinstgeorge.com

# Cloudflare Worker / Source Layer
SPARK_API_BASE_URL=
# Set the token as a Wrangler secret, not in this file:
# bunx wrangler secret put SPARK_ACCESS_TOKEN --config apps/api/wrangler.toml

# API security
API_WRITE_ORIGINS=https://homeinstgeorgeutah.com,https://www.homeinstgeorgeutah.com,https://benlane.us,http://localhost:4321,http://localhost:8787
TURNSTILE_SECRET_KEY=

# Cloudflare D1 is the source of truth for operational state.
# Configure the DB binding in apps/api/wrangler.toml.

# Optional downstream utilities only. They must not own canonical records or routing logic.
CRM_WEBHOOK_URL=
BOOKING_HANDOFF_URL=
EMAIL_DELIVERY_WEBHOOK_URL=
SMS_DELIVERY_WEBHOOK_URL=
