{
  "name": "homeinstgeorge-modern-stack",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "bun --filter @home/site dev",
    "dev:api": "bun --filter @home/api dev",
    "dev:app": "bun --filter @home/app dev",
    "build": "bun --filter '*' build",
    "check": "bunx biome check .",
    "fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "test": "bun --filter '*' test",
    "test:unit": "bun test apps/api/src",
    "test:e2e": "bunx playwright test",
    "build:site": "bun --filter @home/site build",
    "audit:architecture": "python3 scripts/audit-architecture-drift.py",
    "audit:fair-housing": "python3 scripts/audit-fair-housing.py",
    "build:site:cloudflare": "bun install --frozen-lockfile && bun run build:site"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "postcss": "8.5.18",
    "sharp": "0.35.3",
    "svgo": "4.0.2",
    "undici": "7.29.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@playwright/test": "1.61.0",
    "typescript": "6.0.3",
    "wrangler": "4.113.0"
  }
}
