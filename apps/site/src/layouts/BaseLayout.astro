---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileActionBar from "../components/MobileActionBar.astro";
import "../styles/global.css";
import { canonical, realtorSchema, title as makeTitle } from "@home/config/seo";
import { site } from "@home/config/site";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, pathname = "/", schema } = Astro.props;

const pageTitle = makeTitle(title);
const pageUrl = canonical(pathname);
const schemaItems = Array.isArray(schema)
  ? [realtorSchema(), ...schema]
  : schema
    ? [realtorSchema(), schema]
    : [realtorSchema()];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <link rel="icon" href="/favicon.ico?v=sot-20260609" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=sot-20260609" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=sot-20260609" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png?v=sot-20260609" />
    <meta name="theme-color" content="#1c1917" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="/brand/portfolio/st-george-luxury-evening-home.webp" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/brand/portfolio/st-george-luxury-evening-home.webp" />

    <script type="application/ld+json" set:html={JSON.stringify(schemaItems)} />
  </head>

  <body class="site-shell">
    <Header />
    <main>
      <slot />
    </main>
    <MobileActionBar />
    <Footer />
  </body>
</html>
