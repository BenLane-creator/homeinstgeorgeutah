---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";

function entrySlug(entry: CollectionEntry<"blog">) {
  return entry.data.slug || entry.id.replace(/\.(md|mdx)$/i, "");
}

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"blog"> };
const slug = entrySlug(entry);
const { title, description = `${entry.data.title} from Home In St. George.`, pubDate, author, category } = entry.data;
const { Content } = await render(entry);
const published = pubDate
  ? new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" }).format(pubDate)
  : null;
---

<BaseLayout title={title} pathname={`/blog/${slug}/`} description={description}>
  <section class="bg-[var(--brand-warm-ivory)] px-5 py-20 sm:py-24">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-bold uppercase tracking-[0.24em] text-[var(--brand-gold)]">
        {category || "Market guide"}
      </p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.045em] text-[var(--brand-ink)] md:text-6xl">
        {title}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">{description}</p>
      {(published || author) && (
        <p class="mt-6 text-sm font-medium text-stone-500">
          {published}{published && author ? " · " : ""}{author}
        </p>
      )}
    </div>
  </section>

  <section class="bg-white px-5 py-16 sm:py-20">
    <article class="prose prose-stone mx-auto max-w-4xl text-lg leading-8 text-stone-700">
      <Content />
    </article>
  </section>

  <CTA />
</BaseLayout>
