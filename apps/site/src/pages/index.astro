---
import CTA from "../components/CTA.astro";
import Funnels from "../components/Funnels.astro";
import Hero from "../components/Hero.astro";
import NeighborhoodCards from "../components/NeighborhoodCards.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "@home/config/site";
---

<BaseLayout title="St. George Real Estate">
  <Hero />

  <section class="bg-[#fffaf3] px-5 py-20">
    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-3">
      <div class="brand-card rounded-[1.75rem] p-8">
        <p class="brand-eyebrow">Local market</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold">Southern Utah clarity</h2>
        <p class="mt-4 text-[#4f4942]">Local guidance for St. George, Washington, Santa Clara, Ivins, Hurricane, and the surrounding Southern Utah market.</p>
      </div>
      <div class="brand-card rounded-[1.75rem] p-8">
        <p class="brand-eyebrow">Owned search path</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold">First-party experience</h2>
        <p class="mt-4 text-[#4f4942]">The public site, lead forms, attribution, saved-interest paths, and contact history remain owned by HomeInStGeorgeUtah.com.</p>
      </div>
      <div class="brand-card rounded-[1.75rem] p-8">
        <p class="brand-eyebrow">Mobile first</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold">Fast on phones</h2>
        <p class="mt-4 text-[#4f4942]">The interface is designed around mobile search behavior, clear tap targets, readable property paths, and fast conversion flow.</p>
      </div>
    </div>
  </section>

  <NeighborhoodCards />
  <Funnels />

  <section class="bg-[#f5f0e8] px-5 py-20">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[0.78fr_1fr] md:items-center">
      <div class="brand-card overflow-hidden rounded-[2rem] bg-white p-4">
        <img
          src="/brand/portrait/joel-robertson-portrait-formal.webp"
          alt="Joel Robertson, Robertson Real Estate advisor in Saint George, Utah"
          class="aspect-[4/5] max-h-[620px] w-full rounded-[1.5rem] object-cover object-top"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div>
        <p class="brand-eyebrow">Broker guidance</p>
        <h2 class="mt-4 max-w-3xl font-serif text-4xl font-semibold tracking-tight text-[#1c1917] md:text-5xl">
          Work directly with Joel Robertson of Robertson Real Estate.
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[#4f4942]">
          Joel brings long-standing St. George and Southern Utah real estate experience to buyers, sellers, and relocating clients who want clear advice before making a move.
        </p>
        <div class="mt-8 grid gap-4 rounded-[1.75rem] border border-[#e3d8ca] bg-[#fffaf3]/80 p-6 sm:grid-cols-[1fr_1fr_auto] sm:items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#7A8B75]">Broker</p>
            <p class="mt-2 font-serif text-2xl font-semibold">{site.brokerName}</p>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#7A8B75]">Company</p>
            <p class="mt-2 font-serif text-2xl font-semibold">{site.companyName}</p>
          </div>
          <img
            src="/brand/logos/robertson-seal-light.webp"
            alt="Robertson Real Estate seal"
            class="hidden h-20 w-20 rounded-full object-cover sm:block"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/" class="brand-button-primary">
            Contact Joel
          </a>
          <a href="/about/" class="brand-button-outline">
            Learn about Joel
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
