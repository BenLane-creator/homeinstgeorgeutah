---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import NeighborhoodCards from "../components/NeighborhoodCards.astro";
import Funnels from "../components/Funnels.astro";
import CTA from "../components/CTA.astro";
import { site } from "@home/config/site";
---
<BaseLayout title="St. George Real Estate" pathname="/">
  <Hero />

  <section class="bg-white px-5 py-14">
    <div class="mx-auto max-w-7xl rounded-3xl border border-stone-200 bg-[#fffaf3] p-6 shadow-sm md:p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">Start with the search</p>
      <form action="/homes/search/" method="get" class="mt-5 grid gap-3 md:grid-cols-[1.2fr_0.7fr_0.7fr_auto]">
        <input name="q" placeholder="City, neighborhood, feature, or MLS keyword" class="rounded-2xl border border-stone-200 bg-white px-4 py-4" />
        <input name="maxPrice" inputmode="numeric" placeholder="Max price" class="rounded-2xl border border-stone-200 bg-white px-4 py-4" />
        <select name="beds" class="rounded-2xl border border-stone-200 bg-white px-4 py-4">
          <option value="">Beds</option>
          <option value="2">2+</option>
          <option value="3">3+</option>
          <option value="4">4+</option>
          <option value="5">5+</option>
        </select>
        <button type="submit" class="rounded-2xl bg-stone-950 px-6 py-4 font-semibold text-white">Search homes</button>
      </form>
      <div class="mt-4 flex flex-wrap gap-2 text-sm font-semibold">
        <a href="/homes/search/?q=new-construction" class="rounded-full bg-white px-4 py-2 text-stone-700 ring-1 ring-stone-200">New construction</a>
        <a href="/homes/search/?q=golf" class="rounded-full bg-white px-4 py-2 text-stone-700 ring-1 ring-stone-200">Golf communities</a>
        <a href="/homes/search/?q=view" class="rounded-full bg-white px-4 py-2 text-stone-700 ring-1 ring-stone-200">View homes</a>
        <a href="/homes/search/?q=horse-property" class="rounded-full bg-white px-4 py-2 text-stone-700 ring-1 ring-stone-200">Horse properties</a>
      </div>
    </div>
  </section>

  <NeighborhoodCards />
  <Funnels />

  <section class="bg-white px-5 py-20">
    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-3">
      <div class="rounded-3xl border border-stone-200 p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-900/70">Owned product</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold">First-party search and lead flow</h2>
        <p class="mt-4 text-stone-600">Search behavior, contact context, lead events, attribution, workflow lane, and reporting belong to the website instead of a vendor dashboard.</p>
      </div>
      <div class="rounded-3xl border border-stone-200 p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-900/70">MLS safe</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold">Approved source boundary</h2>
        <p class="mt-4 text-stone-600">Listing data is accessed only through Washington County BOR IDX and Spark® / RESO Web API rules, with display permissions handled in the app.</p>
      </div>
      <div class="rounded-3xl border border-stone-200 p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-900/70">Mobile first</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold">Built for quick decisions</h2>
        <p class="mt-4 text-stone-600">Buyers, sellers, and relocating clients get fast search paths, tap-ready CTAs, and forms that carry the page and device context into the lead engine.</p>
      </div>
    </div>
  </section>

  <section class="bg-[#fffaf3] px-5 py-20">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.1fr_0.9fr] md:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">Broker guidance</p>
        <h2 class="mt-4 max-w-3xl font-serif text-4xl font-semibold tracking-tight text-stone-950 md:text-5xl">
          Work directly with Joel Robertson of Robertson Real Estate.
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-700">
          Joel brings 20+ years of St. George and Southern Utah real estate experience to buyers, sellers, and relocating clients who want clear advice before making a move.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/?intent=general_contact" class="rounded-full bg-stone-950 px-7 py-4 text-center font-semibold text-white hover:bg-stone-800">
            Contact Joel
          </a>
          <a href="/about/" class="rounded-full bg-white px-7 py-4 text-center font-semibold text-stone-950 ring-1 ring-stone-200 hover:bg-stone-50">
            Learn about Joel
          </a>
        </div>
      </div>

      <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm">
        <dl class="grid gap-6">
          <div>
            <dt class="text-sm font-semibold uppercase tracking-[0.2em] text-stone-500">Broker</dt>
            <dd class="mt-2 text-2xl font-semibold text-stone-950">{site.brokerName}</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-[0.2em] text-stone-500">Company</dt>
            <dd class="mt-2 text-2xl font-semibold text-stone-950">{site.companyName}</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-[0.2em] text-stone-500">Direct contact</dt>
            <dd class="mt-2 text-lg text-stone-700">
              <a class="font-semibold text-stone-950" href={site.phoneHref}>{site.phone}</a><br />
              <a class="font-semibold text-stone-950" href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
