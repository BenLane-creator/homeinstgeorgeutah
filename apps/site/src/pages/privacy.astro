---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "@home/config/site";

const updated = "July 20, 2026";
---

<BaseLayout
  title={`Privacy Policy | ${site.companyName}`}
  description={`How ${site.companyName} handles information submitted through ${site.name}.`}
>
  <section class="bg-[var(--brand-warm-ivory)] px-5 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-[var(--brand-clay)]">Privacy</p>
      <h1 class="mt-4 text-4xl font-black tracking-[-0.04em] text-[var(--brand-ink)] sm:text-6xl">
        Your information deserves careful handling.
      </h1>
      <p class="mt-6 text-sm text-[var(--brand-muted)]">Last updated {updated}</p>

      <div class="mt-12 space-y-10 text-base leading-8 text-[var(--brand-ink)]">
        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Information we collect</h2>
          <p class="mt-3">
            When you submit a search, property inquiry, valuation request, or contact form, we may collect
            your name, email address, phone number, message, property details, search preferences, and the
            page that prompted your request. We may also receive limited technical information such as
            device, browser, referral, campaign, and security data.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">How we use it</h2>
          <p class="mt-3">
            We use this information to answer your request, provide real estate guidance, operate and secure
            the website, understand service performance, maintain required records, and comply with
            applicable law. Submitting a form does not obligate you to buy or sell property.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Service providers and listing data</h2>
          <p class="mt-3">
            We may share information with vendors that support hosting, security, communications, customer
            follow-up, analytics, and approved MLS/IDX services. These providers receive information only
            as needed to perform their services. Property information may be supplied by participating
            listing brokers and MLS organizations and is subject to their rules and notices.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Retention and choices</h2>
          <p class="mt-3">
            We retain information for as long as reasonably necessary for the purposes described above,
            including legal, security, and recordkeeping needs. You may ask to access, correct, or delete
            information you submitted, subject to applicable exceptions.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Contact</h2>
          <p class="mt-3">
            Questions or privacy requests can be sent to
            <a class="font-bold underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>
            or discussed at
            <a class="font-bold underline underline-offset-4" href={site.phoneHref}>{site.phone}</a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
