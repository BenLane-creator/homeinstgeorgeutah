---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { site } from "@home/config/site";
---

<BaseLayout
  title="Contact Joel Robertson"
  pathname="/contact/"
  description="Contact Joel Robertson of Robertson Real Estate for direct St. George and Southern Utah buying, selling, relocation, and property guidance."
>
  <section class="bg-[var(--brand-warm-ivory)] px-5 py-16 sm:py-20 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1fr_0.72fr] lg:items-start">
      <div class="max-w-4xl">
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-[var(--brand-gold)]">
          Direct broker guidance
        </p>
        <h1 class="mt-5 text-5xl font-medium leading-[0.95] tracking-[-0.055em] text-[var(--brand-ink)] sm:text-6xl md:text-7xl">
          Start with a clear conversation.
        </h1>
        <p class="mt-7 max-w-3xl text-lg leading-9 text-stone-700">
          Whether you are buying, selling, relocating, or evaluating a specific property, share what you are considering and the questions that matter most. Joel will help you identify the right next step.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.phoneHref}
            class="inline-flex min-h-14 items-center justify-center bg-[var(--brand-ink)] px-7 text-sm font-bold uppercase tracking-[0.14em] text-white transition hover:bg-[var(--brand-deep-olive)]"
          >
            Call {site.phone}
          </a>
          <a
            href="/homes/search/"
            class="inline-flex min-h-14 items-center justify-center border border-stone-300 bg-white px-7 text-sm font-bold uppercase tracking-[0.14em] text-[var(--brand-ink)] transition hover:border-[var(--brand-gold)]"
          >
            Search homes
          </a>
        </div>
      </div>

      <aside class="border border-[var(--brand-pink-sand)] bg-white p-7 shadow-xl shadow-stone-900/5 sm:p-9">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-[var(--brand-gold)]">
          Robertson Real Estate
        </p>
        <h2 class="mt-4 text-2xl font-semibold text-[var(--brand-ink)]">
          Joel Robertson
        </h2>
        <p class="mt-2 text-stone-600">Principal broker · St. George, Utah</p>

        <dl class="mt-8 grid gap-6 border-t border-stone-200 pt-6">
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.16em] text-stone-500">
              Phone
            </dt>
            <dd class="mt-2">
              <a class="font-semibold text-[var(--brand-ink)]" href={site.phoneHref}>
                {site.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.16em] text-stone-500">
              Email
            </dt>
            <dd class="mt-2 break-all">
              <a class="font-semibold text-[var(--brand-ink)]" href={`mailto:${site.email}`}>
                {site.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.16em] text-stone-500">
              Service area
            </dt>
            <dd class="mt-2 leading-7 text-stone-700">
              St. George and Southern Utah
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <CTA
    intent="general_contact"
    variant="general"
    eyebrow="Tell Joel what you need"
    title="Get a local plan before you make a move."
    copy="Share your goals, timing, and questions. Joel will respond directly with practical guidance and clear next steps."
    badges={["Buying", "Selling", "Relocating"]}
  />
</BaseLayout>
