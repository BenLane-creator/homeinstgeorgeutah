---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import { featuredSearches } from "@home/config/routes";
import { site } from "@home/config/site";
import SearchResultsIsland from "../../components/SearchResultsIsland";
---

<BaseLayout
  title="Search St. George Homes"
  pathname="/homes/search/"
  description="Search St. George and Southern Utah homes through a custom, first-party MLS search experience backed by Washington County MLS, Iron County MLS, and approved Spark/RESO access."
>
  <section class="bg-[#fffaf3] px-5 py-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">
          First-party MLS search
        </p>

        <h1 class="mt-4 font-serif text-5xl font-semibold tracking-tight text-stone-950 md:text-6xl">
          Search Southern Utah homes with local context built in.
        </h1>

        <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
          This page is the product shell for the custom search experience. The frontend owns the UX while the Worker talks to the approved Source Layer behind a compliance boundary.
        </p>
      </div>

      <form action="/homes/search/" method="get" class="mt-10 rounded-3xl border border-stone-200 bg-white p-5 shadow-xl shadow-stone-900/5 md:p-6">
        <div class="grid gap-3 md:grid-cols-[1.3fr_0.8fr_0.8fr_0.7fr_0.7fr]">
          <input name="q" placeholder="City, neighborhood, feature, or keyword" class="rounded-2xl border border-stone-200 px-4 py-4" />
          <input name="minPrice" inputmode="numeric" placeholder="Min price" class="rounded-2xl border border-stone-200 px-4 py-4" />
          <input name="maxPrice" inputmode="numeric" placeholder="Max price" class="rounded-2xl border border-stone-200 px-4 py-4" />
          <select name="beds" class="rounded-2xl border border-stone-200 px-4 py-4">
            <option value="">Beds</option>
            <option value="2">2+</option>
            <option value="3">3+</option>
            <option value="4">4+</option>
            <option value="5">5+</option>
          </select>
          <button type="submit" class="rounded-2xl bg-stone-950 px-6 py-4 font-semibold text-white">Search</button>
        </div>

        <div class="mt-4 flex flex-wrap gap-2 text-sm font-semibold">
          {featuredSearches.map((item) => (
            <a href={item.href} class="rounded-full bg-[#fffaf3] px-4 py-2 text-stone-700 ring-1 ring-stone-200 hover:bg-stone-50">
              {item.label}
            </a>
          ))}
        </div>
      </form>


      <SearchResultsIsland client:load />

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <a href="/api/v1/search/execute?city=St.%20George&limit=6" class="rounded-3xl border border-stone-200 bg-white p-6 hover:bg-stone-50">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-stone-500">API check</p>
          <h2 class="mt-3 font-serif text-2xl font-semibold text-stone-950">Search endpoint</h2>
          <p class="mt-3 text-sm leading-6 text-stone-600">The public UI is wired toward the Worker route, not a vendor-owned search page.</p>
        </a>
        <a href="/contact/?intent=buyer_active_search" class="rounded-3xl border border-stone-200 bg-white p-6 hover:bg-stone-50">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-stone-500">High intent</p>
          <h2 class="mt-3 font-serif text-2xl font-semibold text-stone-950">Save this search</h2>
          <p class="mt-3 text-sm leading-6 text-stone-600">The first version routes through the lead engine until accounts and alerts are enabled.</p>
        </a>
        <a href={site.phoneHref} class="rounded-3xl border border-stone-200 bg-white p-6 hover:bg-stone-50">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-stone-500">Local help</p>
          <h2 class="mt-3 font-serif text-2xl font-semibold text-stone-950">Ask Joel</h2>
          <p class="mt-3 text-sm leading-6 text-stone-600">Call directly when you want current availability, showing help, or neighborhood guidance.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
      <div class="rounded-3xl border border-stone-200 p-8">
        <h2 class="font-serif text-2xl font-semibold text-stone-950">Owned UX</h2>
        <p class="mt-4 leading-7 text-stone-600">
          Search state, property CTAs, saved-search intent, and lead context stay inside the product layer.
        </p>
      </div>

      <div class="rounded-3xl border border-stone-200 p-8">
        <h2 class="font-serif text-2xl font-semibold text-stone-950">Replaceable source</h2>
        <p class="mt-4 leading-7 text-stone-600">
          Listing access belongs behind the Source Layer adapter so provider changes do not rewrite the public site.
        </p>
      </div>

      <div class="rounded-3xl border border-stone-200 p-8">
        <h2 class="font-serif text-2xl font-semibold text-stone-950">Compliance boundary</h2>
        <p class="mt-4 leading-7 text-stone-600">
          MLS attribution, field visibility, media rights, update timestamps, and disclaimers are handled before display.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#fffaf3] px-5 py-20">
    <div class="mx-auto max-w-5xl rounded-3xl border border-stone-200 bg-white p-8 md:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">
        Launch search checklist
      </p>

      <h2 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-stone-950">
        Product-ready MLS search features.
      </h2>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {[
          "City and neighborhood filters",
          "Price, bed, bath, and property-type filters",
          "Mobile-first cards and sticky CTAs",
          "MLS attribution and required disclaimers",
          "Lead capture tied to search and listing context",
          "Saved searches and alerts owned by the product layer",
        ].map((item) => (
          <div class="rounded-2xl border border-stone-200 px-5 py-4 font-semibold text-stone-700">
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA
    intent="buyer_active_search"
    variant="property_inquiry"
    eyebrow="Search help"
    title="Ask about a property or search criteria."
    copy="Send a property question, listing reference, or search need. The request enters the owned lead engine before any downstream handoff."
    badges={["Property question", "Search intent", "Local context"]}
/>
</BaseLayout>
