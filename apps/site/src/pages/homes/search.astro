---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import { site } from "@home/config/site";
---

<BaseLayout
  title="Search St. George Homes"
  pathname="/homes/search/"
  description="Search St. George and Southern Utah homes through the custom MLS search experience being built with Washington County BOR IDX and Spark RESO Web API access."
>
  <section class="bg-[#fffaf3] px-5 py-24">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">
        MLS Search
      </p>

      <h1 class="mt-4 max-w-4xl font-serif text-5xl font-semibold tracking-tight text-stone-950 md:text-6xl">
        Custom Southern Utah MLS search is being built here.
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        This page is the future custom search experience for St. George and Southern Utah listings using Washington County BOR IDX approval and Spark® / RESO Web API access.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="/contact/"
          class="rounded-full bg-stone-950 px-6 py-3 text-center font-semibold text-white hover:bg-stone-800"
        >
          Ask Joel about current homes
        </a>

        <a
          href="/neighborhoods/"
          class="rounded-full bg-white px-6 py-3 text-center font-semibold text-stone-950 ring-1 ring-stone-200 hover:bg-stone-50"
        >
          Compare neighborhoods
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
      <div class="rounded-3xl border border-stone-200 p-8">
        <h2 class="font-serif text-2xl font-semibold text-stone-950">
          IDX authorization
        </h2>
        <p class="mt-4 leading-7 text-stone-600">
          MLS display will be based on Washington County BOR IDX approval and applicable display rules.
        </p>
      </div>

      <div class="rounded-3xl border border-stone-200 p-8">
        <h2 class="font-serif text-2xl font-semibold text-stone-950">
          Spark® / RESO API
        </h2>
        <p class="mt-4 leading-7 text-stone-600">
          Listing search and detail data will be served through a custom Cloudflare Worker connected to Spark® / RESO Web API access.
        </p>
      </div>

      <div class="rounded-3xl border border-stone-200 p-8">
        <h2 class="font-serif text-2xl font-semibold text-stone-950">
          Local guidance
        </h2>
        <p class="mt-4 leading-7 text-stone-600">
          Until the custom MLS search is fully active, contact Joel Robertson directly for current listing help and property-specific guidance.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#fffaf3] px-5 py-20">
    <div class="mx-auto max-w-5xl rounded-3xl border border-stone-200 bg-white p-8 md:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">
        Build target
      </p>

      <h2 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-stone-950">
        Planned custom search features.
      </h2>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {[
          "City and neighborhood filters",
          "Price, bed, bath, and property-type filters",
          "Listing grid and detail pages",
          "MLS attribution and required disclaimers",
          "Lead capture tied to listing context",
          "Saved search and favorites in a later phase",
        ].map((item) => (
          <div class="rounded-2xl border border-stone-200 px-5 py-4 font-semibold text-stone-700">
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
