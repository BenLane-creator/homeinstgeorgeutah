---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import SearchResultsIsland from "../../components/SearchResultsIsland";
import { featuredSearches } from "@home/config/routes";
---

<BaseLayout
  title="Homes for Sale in Southern Utah"
  pathname="/homes/search/"
  description="Search for homes across Washington County and Iron County, then get direct local guidance from Joel Robertson of Robertson Real Estate."
>
  <section class="bg-[var(--brand-warm-ivory)] px-5 py-16 sm:py-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-4xl">
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-[var(--brand-gold)]">
          Washington County and Iron County homes
        </p>
        <h1 class="mt-5 text-5xl font-medium leading-[0.95] tracking-[-0.055em] text-[var(--brand-ink)] sm:text-6xl md:text-7xl">
          Find the right home with local context.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
          Choose the MLS county scope, then share the location and property details that matter to you. When each independently authorized feed is available, results will appear here; Joel can provide current availability directly in the meantime.
        </p>
      </div>

      <form
        action="/homes/search/"
        method="get"
        class="mt-10 border border-[var(--brand-pink-sand)] bg-white p-5 shadow-xl shadow-stone-900/5 sm:p-6"
        aria-label="Search homes"
      >
        <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-[0.8fr_1.4fr_0.75fr_0.75fr_0.62fr_0.62fr_auto]">
          <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.12em] text-stone-600">
            MLS county
            <select
              name="county"
              class="min-h-13 border border-stone-300 bg-white px-4 text-base font-medium normal-case tracking-normal text-[var(--brand-ink)]"
            >
              <option value="washington">Washington County</option>
              <option value="iron">Iron County</option>
            </select>
          </label>

          <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.12em] text-stone-600">
            Location or keyword
            <input
              name="q"
              placeholder="City, neighborhood, feature, or MLS number"
              class="min-h-13 border border-stone-300 bg-white px-4 text-base font-medium normal-case tracking-normal text-[var(--brand-ink)] placeholder:font-normal"
            />
          </label>

          <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.12em] text-stone-600">
            Minimum price
            <input
              name="minPrice"
              inputmode="numeric"
              placeholder="No minimum"
              class="min-h-13 border border-stone-300 bg-white px-4 text-base font-medium normal-case tracking-normal text-[var(--brand-ink)] placeholder:font-normal"
            />
          </label>

          <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.12em] text-stone-600">
            Maximum price
            <input
              name="maxPrice"
              inputmode="numeric"
              placeholder="No maximum"
              class="min-h-13 border border-stone-300 bg-white px-4 text-base font-medium normal-case tracking-normal text-[var(--brand-ink)] placeholder:font-normal"
            />
          </label>

          <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.12em] text-stone-600">
            Bedrooms
            <select
              name="beds"
              class="min-h-13 border border-stone-300 bg-white px-4 text-base font-medium normal-case tracking-normal text-[var(--brand-ink)]"
            >
              <option value="">Any</option>
              <option value="2">2+</option>
              <option value="3">3+</option>
              <option value="4">4+</option>
              <option value="5">5+</option>
            </select>
          </label>

          <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.12em] text-stone-600">
            Bathrooms
            <select
              name="baths"
              class="min-h-13 border border-stone-300 bg-white px-4 text-base font-medium normal-case tracking-normal text-[var(--brand-ink)]"
            >
              <option value="">Any</option>
              <option value="2">2+</option>
              <option value="3">3+</option>
              <option value="4">4+</option>
              <option value="5">5+</option>
            </select>
          </label>

          <button
            type="submit"
            class="mt-auto min-h-13 bg-[var(--brand-ink)] px-7 text-sm font-bold uppercase tracking-[0.14em] text-white transition hover:bg-[var(--brand-deep-olive)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--brand-gold)]"
          >
            Search homes
          </button>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-2">
          <span class="mr-2 text-xs font-bold uppercase tracking-[0.14em] text-stone-500">
            Popular
          </span>
          {featuredSearches.map((item) => (
            <a
              href={item.href}
              class="inline-flex min-h-10 items-center border border-stone-300 bg-white px-4 text-sm font-semibold text-stone-700 transition hover:border-[var(--brand-gold)] hover:text-[var(--brand-ink)]"
            >
              {item.label}
            </a>
          ))}
        </div>
      </form>
    </div>
  </section>

  <section class="bg-white px-5 py-10 sm:py-14">
    <div class="mx-auto max-w-7xl">
      <SearchResultsIsland client:load />
    </div>
  </section>

  <section class="border-y border-[var(--brand-pink-sand)] bg-[var(--brand-warm-ivory)] px-5 py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.26em] text-[var(--brand-gold)]">
          Search with confidence
        </p>
        <h2 class="mt-4 text-4xl font-medium leading-tight tracking-[-0.045em] text-[var(--brand-ink)] sm:text-5xl">
          A listing is the beginning of the decision.
        </h2>
      </div>

      <div class="grid gap-px border border-[var(--brand-pink-sand)] bg-[var(--brand-pink-sand)] sm:grid-cols-3">
        {[
          ["Local context", "Review location, access, HOA terms, terrain, and resale factors around the home."],
          ["Property review", "Look beyond photos to condition, inspections, utilities, zoning, and ownership considerations."],
          ["Offer strategy", "Shape price, terms, timing, and contingencies around the property and current market."],
        ].map(([title, copy]) => (
          <article class="bg-white p-6 sm:p-7">
            <h3 class="text-lg font-semibold text-[var(--brand-ink)]">{title}</h3>
            <p class="mt-3 text-sm leading-7 text-stone-600">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    intent="buyer_active_search"
    variant="property_inquiry"
    eyebrow="Property guidance"
    title="Ask about a home or start a tailored search."
    copy="Share a property, neighborhood, price range, or question. Joel will respond with direct local guidance and clear next steps."
    badges={["Property questions", "Area guidance", "Showing help"]}
  />
</BaseLayout>
