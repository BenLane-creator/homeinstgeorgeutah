---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { site } from "@home/config/site";

const pageTitle = "Moving to St. George & Southern Utah";
const searchUrl = site.flexmlsSearchUrl.endsWith("/")
  ? site.flexmlsSearchUrl
  : `${site.flexmlsSearchUrl}/`;
---

<BaseLayout
  title={pageTitle}
  pathname="/relocation"
  description="Relocation guidance for buyers moving to St. George and Southern Utah from Joel Robertson of Robertson Real Estate."
>
  <section class="bg-[#fffaf3] px-5 py-24">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">
        Relocation
      </p>

      <h1 class="mt-4 max-w-4xl font-serif text-5xl font-semibold tracking-tight text-stone-950 md:text-6xl">
        Moving to St. George or Southern Utah?
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        Relocating is more than choosing a house. Joel Robertson helps buyers compare neighborhoods, lifestyle fit, commute patterns, property types, schools, services, and long-term resale considerations across St. George and Southern Utah.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={searchUrl} class="rounded-full bg-stone-950 px-6 py-3 text-center font-semibold text-white hover:bg-stone-800">
          Search homes
        </a>

        <a href="/contact/" class="rounded-full bg-white px-6 py-3 text-center font-semibold text-stone-950 ring-1 ring-stone-200 hover:bg-stone-50">
          Talk to Joel
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-3">
      <div class="rounded-3xl border border-stone-200 p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-900/70">
          Area Fit
        </p>

        <h2 class="mt-3 font-serif text-3xl font-semibold text-stone-950">
          Compare communities clearly
        </h2>

        <p class="mt-4 leading-7 text-stone-600">
          St. George, Washington, Santa Clara, Ivins, Hurricane, and the surrounding towns each offer a different mix of convenience, views, lot sizes, growth, services, and lifestyle.
        </p>
      </div>

      <div class="rounded-3xl border border-stone-200 p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-900/70">
          Property Fit
        </p>

        <h2 class="mt-3 font-serif text-3xl font-semibold text-stone-950">
          Know what to verify
        </h2>

        <p class="mt-4 leading-7 text-stone-600">
          Relocation buyers should review HOA rules, utilities, zoning, road access, lot usability, flood or wash proximity, elevation, maintenance needs, and resale factors before writing an offer.
        </p>
      </div>

      <div class="rounded-3xl border border-stone-200 p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-900/70">
          Local Guidance
        </p>

        <h2 class="mt-3 font-serif text-3xl font-semibold text-stone-950">
          Work with local context
        </h2>

        <p class="mt-4 leading-7 text-stone-600">
          Joel brings 20+ years of Southern Utah real estate experience to help relocating clients make informed decisions before committing to a location or property.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#fffaf3] px-5 py-20">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1fr_0.85fr] md:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">
          Relocation checklist
        </p>

        <h2 class="mt-4 font-serif text-4xl font-semibold tracking-tight text-stone-950">
          What to compare before choosing an area.
        </h2>

        <p class="mt-5 max-w-3xl leading-8 text-stone-700">
          The right Southern Utah location depends on how you plan to live, work, commute, recreate, and hold the property long term. A relocation search should compare more than price and square footage.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {[
            "Drive time to work, services, medical care, and shopping",
            "School boundary and transportation considerations",
            "HOA rules, fees, rental rules, and architectural restrictions",
            "New construction versus established neighborhoods",
            "Outdoor access, trails, golf, parks, and recreation proximity",
            "Utilities, septic, water, road access, and rural-property factors",
            "Sun exposure, views, terrain, washes, and lot usability",
            "Resale demand and long-term neighborhood trajectory",
          ].map((item) => (
            <div class="rounded-2xl border border-stone-200 bg-white p-5 text-stone-700">
              {item}
            </div>
          ))}
        </div>
      </div>

      <aside class="rounded-3xl border border-stone-200 bg-white p-8">
        <h3 class="font-serif text-3xl font-semibold text-stone-950">
          Popular relocation areas
        </h3>

        <p class="mt-4 leading-7 text-stone-600">
          Many relocating buyers compare several communities before deciding where to focus.
        </p>

        <div class="mt-6 grid gap-3">
          {[
            ["St. George", "/neighborhoods/st-george/"],
            ["Washington", "/neighborhoods/washington/"],
            ["Santa Clara", "/neighborhoods/santa-clara/"],
            ["Ivins", "/neighborhoods/ivins/"],
            ["Hurricane", "/neighborhoods/hurricane/"],
            ["Little Valley", "/neighborhoods/little-valley/"],
            ["Entrada", "/neighborhoods/entrada/"],
            ["Desert Color", "/neighborhoods/desert-color/"],
          ].map(([label, href]) => (
            <a class="rounded-2xl border border-stone-200 px-4 py-3 font-semibold text-stone-800 hover:bg-stone-50" href={href}>
              {label}
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto max-w-5xl rounded-3xl border border-stone-200 p-8 md:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">
        Start the relocation conversation
      </p>

      <h2 class="mt-4 font-serif text-4xl font-semibold tracking-tight text-stone-950">
        Get a practical local read before you visit or write an offer.
      </h2>

      <p class="mt-5 leading-8 text-stone-700">
        Tell Joel what is bringing you to Southern Utah, what kind of lifestyle you want, and what tradeoffs matter most. From there, he can help narrow the search to areas and properties that fit your goals.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="rounded-full bg-stone-950 px-6 py-3 text-center font-semibold text-white hover:bg-stone-800">
          Plan my move
        </a>

        <a href={searchUrl} class="rounded-full bg-white px-6 py-3 text-center font-semibold text-stone-950 ring-1 ring-stone-200 hover:bg-stone-50">
          Search homes
        </a>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
