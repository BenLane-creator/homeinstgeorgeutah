---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "@home/config/site";

const updated = "July 20, 2026";
---

<BaseLayout
  title={`Terms of Use | ${site.companyName}`}
  description={`Terms for using ${site.name}, including real estate search and brokerage information.`}
>
  <section class="bg-[var(--brand-warm-ivory)] px-5 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-[var(--brand-clay)]">Terms of use</p>
      <h1 class="mt-4 text-4xl font-black tracking-[-0.04em] text-[var(--brand-ink)] sm:text-6xl">
        Clear expectations for using this site.
      </h1>
      <p class="mt-6 text-sm text-[var(--brand-muted)]">Last updated {updated}</p>

      <div class="mt-12 space-y-10 text-base leading-8 text-[var(--brand-ink)]">
        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Informational use</h2>
          <p class="mt-3">
            This website provides general real estate information and a way to request brokerage services.
            It is not legal, tax, lending, appraisal, inspection, or other professional advice. Confirm
            material facts with the appropriate qualified professional before making a decision.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Property information</h2>
          <p class="mt-3">
            Listing information is believed reliable but is not guaranteed. Availability, price, status,
            measurements, schools, taxes, restrictions, and other details can change. Listing displays and
            attribution are governed by the approved IDX provider and applicable MLS rules.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Brokerage relationship</h2>
          <p class="mt-3">
            Visiting the site, running a search, or submitting a form does not by itself create an agency,
            fiduciary, or brokerage relationship. Any representation will be established separately in
            writing as required by Utah law.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Acceptable use and ownership</h2>
          <p class="mt-3">
            You may use the site for lawful personal real estate purposes. Do not disrupt the service,
            attempt unauthorized access, scrape or republish protected listing data, or misuse site content.
            Site branding and original content are owned by their respective rights holders.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Fair housing</h2>
          <p class="mt-3">
            {site.companyName} supports equal housing opportunity and provides services without unlawful
            discrimination.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black tracking-[-0.02em]">Contact</h2>
          <p class="mt-3">
            Questions about these terms can be sent to
            <a class="font-bold underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>
            or discussed at
            <a class="font-bold underline underline-offset-4" href={site.phoneHref}>{site.phone}</a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
