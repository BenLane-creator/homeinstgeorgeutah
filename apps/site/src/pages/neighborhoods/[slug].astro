---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import { site } from "@home/config/site";

function entrySlug(entry: CollectionEntry<"neighborhoods">) {
  return entry.data.slug || entry.id.replace(/\.(md|mdx)$/i, "");
}

export async function getStaticPaths() {
  const neighborhoods = await getCollection("neighborhoods");
  return neighborhoods.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"neighborhoods"> };
const slug = entrySlug(entry);
const { title, description = `${entry.data.title} real estate guidance for Washington County, Utah.` } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${title} Real Estate`}
  pathname={`/neighborhoods/${slug}/`}
  description={description}
>
  <section class="bg-[var(--brand-warm-ivory)] px-5 py-20 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <p class="text-xs font-bold uppercase tracking-[0.24em] text-[var(--brand-gold)]">
        Washington County area guide
      </p>
      <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.045em] text-[var(--brand-ink)] md:text-6xl">
        {title} real estate
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">{description}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={site.customSearchUrl}
          class="inline-flex min-h-12 items-center justify-center bg-[var(--brand-ink)] px-6 font-semibold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--brand-gold)]"
        >
          Search homes
        </a>
        <a
          href={`/contact/?intent=buyer_early_stage&area=${encodeURIComponent(title)}`}
          class="inline-flex min-h-12 items-center justify-center border border-[var(--brand-pink-sand)] bg-white px-6 font-semibold text-[var(--brand-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--brand-gold)]"
        >
          Ask Joel about {title}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-16 sm:py-20">
    <article class="prose prose-stone mx-auto max-w-4xl text-lg leading-8 text-stone-700">
      <Content />
    </article>
  </section>

  <section class="border-y border-[var(--brand-pink-sand)] bg-[var(--brand-warm-ivory)] px-5 py-16">
    <div class="mx-auto grid max-w-5xl gap-px bg-[var(--brand-pink-sand)] md:grid-cols-2">
      <article class="bg-white p-7">
        <h2 class="text-2xl font-semibold text-[var(--brand-ink)]">Verify property details</h2>
        <p class="mt-3 leading-7 text-stone-700">
          Confirm zoning, utilities, access, HOA terms, floodplain status, and property-specific conditions before making a decision.
        </p>
      </article>
      <article class="bg-white p-7">
        <h2 class="text-2xl font-semibold text-[var(--brand-ink)]">Use local guidance</h2>
        <p class="mt-3 leading-7 text-stone-700">
          Joel Robertson helps buyers and sellers evaluate location, pricing, property condition, and resale considerations.
        </p>
      </article>
    </div>
  </section>

  <CTA />
</BaseLayout>
