---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";

function entrySlug(entry: CollectionEntry<"neighborhoods">) {
  return entry.data.slug || entry.id.replace(/\.(md|mdx)$/i, "");
}

const neighborhoods = (await getCollection("neighborhoods")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="St. George & Washington County Neighborhoods"
  pathname="/neighborhoods/"
  description="Compare St. George and Washington County area guides using objective property, location, access, and due-diligence information."
>
  <section class="bg-[var(--brand-warm-ivory)] px-5 py-20 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <p class="text-xs font-bold uppercase tracking-[0.24em] text-[var(--brand-gold)]">
        Neighborhoods and area guides
      </p>
      <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-[-0.045em] text-[var(--brand-ink)] md:text-6xl">
        Compare St. George and Washington County areas.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">
        Review property types, access, utilities, zoning, HOA considerations, terrain, and other due-diligence factors before narrowing a home search.
      </p>
    </div>
  </section>

  <section class="bg-white px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {neighborhoods.map((entry) => (
          <a
            href={`/neighborhoods/${entrySlug(entry)}/`}
            class="border border-[var(--brand-pink-sand)] p-6 transition hover:bg-[var(--brand-warm-ivory)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--brand-gold)]"
          >
            <h2 class="text-2xl font-semibold text-[var(--brand-ink)]">{entry.data.title}</h2>
            <p class="mt-3 leading-7 text-stone-600">
              {entry.data.description || `Property and location guidance for ${entry.data.title}.`}
            </p>
            <span class="mt-5 inline-flex min-h-11 items-center text-sm font-bold uppercase tracking-[0.12em] text-[var(--brand-ink)]">
              Read area guide <span aria-hidden="true" class="ml-3 text-[var(--brand-gold)]">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
