---
import { site } from "@home/config/site";
import { navItems } from "@home/config/routes";
---

<header class="sticky top-0 z-50 border-b border-stone-200/70 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4">
    <a href="/" class="font-serif text-xl font-semibold tracking-tight text-stone-950">
      {site.name}
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-stone-700 md:flex">
      {navItems.slice(0, 6).map((item) => (
        <a class="hover:text-stone-950" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a href="/contact/" class="rounded-full bg-stone-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-stone-800">
      Contact
    </a>
  </div>
</header>
