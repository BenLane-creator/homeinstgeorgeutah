---
import { site } from "@home/config/site";
---

<section class="relative min-h-[calc(100svh-4.75rem)] overflow-hidden bg-[var(--brand-ink)]">
  <picture class="absolute inset-0">
    <source srcset="/brand/hero/robertson-final-sot-hero-master.webp" type="image/webp" />
    <img
      src="/brand/hero/robertson-final-sot-hero-master.png"
      alt="Luxury Southern Utah home with red rock landscape"
      class="h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
  </picture>

  <div class="relative mx-auto flex min-h-[calc(100svh-4.75rem)] max-w-7xl items-start px-5 py-7 sm:py-9 lg:py-12">
    <div class="max-w-xl rounded-[1.75rem] border border-white/35 bg-[var(--brand-warm-ivory)]/52 p-5 shadow-md shadow-stone-950/10 backdrop-blur-[0.5px] sm:p-7 lg:p-8">
      <p class="text-[0.65rem] font-bold uppercase tracking-[0.28em] text-[var(--brand-deep-olive)] sm:text-xs">
        St. George · Southern Utah
      </p>

      <h1 class="mt-4 text-4xl font-bold leading-[0.96] tracking-[-0.055em] text-[var(--brand-ink)] sm:text-5xl lg:text-6xl">
        Modern real estate, guided with precision.
      </h1>

      <p class="mt-5 max-w-lg text-sm leading-7 text-stone-700 sm:text-base">
        Local St. George guidance, first-party home search, and direct broker-level service from Joel Robertson.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={site.customSearchUrl}
          class="rounded-full bg-[var(--brand-ink)] px-6 py-3.5 text-center text-sm font-bold text-[var(--brand-warm-ivory)] shadow-xl shadow-stone-900/10 transition hover:bg-[var(--brand-deep-olive)]"
        >
          Search homes
        </a>

        <a
          href="/contact/?intent=valuation"
          class="rounded-full border border-[var(--brand-clay)] bg-white/85 px-6 py-3.5 text-center text-sm font-bold text-[var(--brand-ink)] shadow-sm transition hover:bg-[var(--brand-clay)]"
        >
          Get home value
        </a>
      </div>
    </div>
  </div>
</section>
