---
import { site } from "@home/config/site";
---

<section class="relative isolate overflow-hidden bg-[#1c1917] text-white">
  <div class="absolute inset-0 -z-10">
    <img
      src="/brand/portfolio/hero-modern-real-estate-clean.webp"
      alt="Modern Southern Utah luxury home with red rock and valley view"
      class="h-full w-full object-cover"
      loading="eager"
      decoding="async"
    />
</div>
<div class="mx-auto grid min-h-[calc(100svh-72px)] max-w-7xl items-center gap-9 px-5 py-14 md:grid-cols-[1.08fr_0.56fr] md:py-20">
    <div>
      <p class="brand-eyebrow text-[#edd8cd]">Robertson Real Estate · Southern Utah</p>
      <h1 class="mt-5 max-w-4xl font-serif text-4xl font-semibold tracking-tight text-white sm:text-5xl md:text-7xl">
        Guided by experience. Focused on you.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[#f5f0e8]">
        A first-party real estate experience for St. George and Southern Utah buyers, sellers, and relocating clients who want precise local guidance before making a move.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/homes/search/" class="brand-button-primary border-white bg-white text-[#1c1917] hover:bg-[#f5f0e8]">
          Search homes
        </a>
        <a href="/sellers/" class="brand-button-outline bg-[#fffaf3]/88 text-[#1c1917]">
          What is my home worth?
        </a>
      </div>
    </div>

    <aside class="brand-card relative mx-auto max-w-[340px] overflow-hidden rounded-[2rem] bg-[#fffaf3]/92 p-3 text-[#1c1917] md:max-w-[360px]">
<img
        src="/brand/portrait/joel-robertson-portrait-modern.webp"
        alt="Joel Robertson, Robertson Real Estate advisor in Saint George, Utah"
        class="aspect-[4/5] max-h-[430px] w-full rounded-[1.55rem] object-cover object-top"
        loading="eager"
        decoding="async"
      />
      <div class="mt-3 rounded-[1.5rem] border border-[#e3d8ca] bg-white/88 p-5">
        <p class="brand-eyebrow">Broker advisor</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold">Joel Robertson</h2>
        <p class="mt-3 text-sm leading-6 text-[#4f4942]">
          Strategic guidance for buyers, sellers, and relocation decisions across {site.market}.
        </p>
        <a href="/contact/" class="mt-5 inline-flex rounded-full bg-[#7A8B75] px-5 py-3 text-sm font-bold uppercase tracking-[0.14em] text-white">
          Contact Joel
        </a>
      </div>
    </aside>
  </div>
</section>
