---
import { site } from "@home/config/site";
---
<section class="relative overflow-hidden bg-[radial-gradient(circle_at_top_left,#f3dfc7,transparent_30%),linear-gradient(135deg,#fffaf3,#efe5d6)]">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-20 md:grid-cols-[1.1fr_0.9fr] md:py-28">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">St. George Real Estate</p>
      <h1 class="mt-5 max-w-4xl font-serif text-5xl font-semibold tracking-tight text-stone-950 md:text-7xl">Find the right home in Southern Utah.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-700">A clean, fast, locally focused home search experience built around first-party search, owned accounts, saved searches, and compliant Spark/RESO data access.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={site.customSearchUrl} class="rounded-full bg-stone-950 px-7 py-4 text-center font-semibold text-white hover:bg-stone-800">Search homes</a>
        <a href="/sellers/" class="rounded-full bg-white px-7 py-4 text-center font-semibold text-stone-950 shadow-sm ring-1 ring-stone-200 hover:bg-stone-50">What is my home worth?</a>
      </div>
    </div>
    <div class="rounded-[2rem] bg-white/70 p-4 shadow-2xl shadow-stone-900/10 ring-1 ring-stone-200 backdrop-blur">
      <div class="rounded-[1.5rem] bg-stone-950 p-6 text-white">
        <p class="text-sm text-stone-300">Primary IDX action</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold">Start with live MLS search</h2>
        <p class="mt-3 text-sm leading-6 text-stone-300">This CTA routes into the first-party search page; the API layer owns compliance gates, account flows, saved searches, and lead capture before any vendor handoff.</p>
        <a href={site.customSearchUrl} class="mt-6 inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-stone-950">Open home search</a>
      </div>
    </div>
  </div>
</section>
