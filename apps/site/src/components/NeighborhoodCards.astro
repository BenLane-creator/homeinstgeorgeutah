---
const neighborhoods = [
  { name: "Downtown St. George", href: "/neighborhoods/downtown-st-george/", copy: "Walkable blocks, historic character, restaurants, and central access." },
  { name: "Entrada", href: "/neighborhoods/entrada/", copy: "Desert golf, red-rock views, and a private-resort feel." },
  { name: "Little Valley", href: "/neighborhoods/little-valley/", copy: "Family-friendly streets, newer homes, parks, and schools." },
  { name: "Washington Fields", href: "/neighborhoods/washington-fields/", copy: "Larger lots, newer builds, and quick access to east-side amenities." },
];
---
<section class="bg-white px-5 py-20">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">Featured areas</p>
        <h2 class="mt-3 font-serif text-4xl font-semibold text-stone-950">Explore Southern Utah neighborhoods</h2>
      </div>
      <a href="/neighborhoods/" class="font-semibold text-stone-950 underline underline-offset-4">View all areas</a>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-4">
      {neighborhoods.map((area) => (
        <a href={area.href} class="rounded-3xl border border-stone-200 bg-stone-50 p-6 transition hover:-translate-y-1 hover:bg-white hover:shadow-xl hover:shadow-stone-900/10">
          <h3 class="font-serif text-2xl font-semibold text-stone-950">{area.name}</h3>
          <p class="mt-3 text-sm leading-6 text-stone-600">{area.copy}</p>
        </a>
      ))}
    </div>
  </div>
</section>
