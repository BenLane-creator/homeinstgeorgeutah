---
const neighborhoods = [
  {
    name: "Winchester Hills",
    href: "/neighborhoods/winchester-hills/",
    copy: "Review homes, lots, access, utilities, and property-specific due diligence in Winchester Hills.",
  },
  {
    name: "Dammeron Valley",
    href: "/neighborhoods/dammeron-valley/",
    copy: "Compare housing, acreage, access, utilities, and ownership considerations in Dammeron Valley.",
  },
  {
    name: "Sunbrook",
    href: "/neighborhoods/sunbrook/",
    copy: "Explore Sunbrook housing and evaluate HOA, golf, property condition, and location details.",
  },
  {
    name: "Ivins",
    href: "/neighborhoods/ivins/",
    copy: "Review Ivins homes with objective context on location, access, terrain, utilities, and restrictions.",
  },
];
---

<section class="bg-white px-5 py-20">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--brand-gold)]">
          Featured areas
        </p>
        <h2 class="mt-3 text-4xl font-semibold text-[var(--brand-ink)]">
          Explore Southern Utah neighborhoods
        </h2>
      </div>
      <a href="/neighborhoods/" class="font-semibold text-[var(--brand-ink)] underline underline-offset-4">
        View all areas
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {neighborhoods.map((area) => (
        <a
          href={area.href}
          class="border border-[var(--brand-pink-sand)] bg-[var(--brand-warm-ivory)] p-6 transition hover:-translate-y-1 hover:bg-white hover:shadow-xl hover:shadow-stone-900/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--brand-gold)]"
        >
          <h3 class="text-2xl font-semibold text-[var(--brand-ink)]">{area.name}</h3>
          <p class="mt-3 text-sm leading-6 text-stone-600">{area.copy}</p>
        </a>
      ))}
    </div>
  </div>
</section>
