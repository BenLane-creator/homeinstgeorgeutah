---
import LeadFormIsland from "./LeadFormIsland";
---
<section class="bg-[#fffaf3] px-5 py-20">
  <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-[1fr_0.8fr]">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">Next step</p>
      <h2 class="mt-3 font-serif text-4xl font-semibold text-stone-950">Get a local plan before you make a move.</h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-700">Use this form for non-IDX lead capture. Flexmls forms and saved-search behaviors should remain inside the IDX enclave unless direct MLS approval says otherwise.</p>
    </div>
    <LeadFormIsland client:visible intent="general" />
  </div>
</section>
