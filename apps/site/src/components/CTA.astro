---
import LeadFormIsland from "./LeadFormIsland";

type LeadFormVariant =
  | "general"
  | "valuation"
  | "relocation"
  | "property_inquiry"
  | "showing_request";

interface Props {
  intent?: string;
  variant?: LeadFormVariant;
  eyebrow?: string;
  title?: string;
  copy?: string;
  badges?: string[];
}

const {
  intent = "general_contact",
  variant = "general",
  eyebrow = "Next step",
  title = "Get a local plan before you make a move.",
  copy = "Send the request through the owned lead engine first. The site keeps the page, device, attribution, and intent context before anything is handed off downstream.",
  badges = ["Buyer search", "Seller strategy", "Relocation help"],
} = Astro.props;
---

<section class="bg-[#fffaf3] px-5 py-20">
  <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-[1fr_0.8fr]">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-amber-900/70">
        {eyebrow}
      </p>
      <h2 class="mt-3 font-serif text-4xl font-semibold text-stone-950">
        {title}
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-700">
        {copy}
      </p>
      <div class="mt-6 grid gap-3 text-sm font-semibold text-stone-700 sm:grid-cols-3">
        {badges.map((badge) => (
          <span class="rounded-2xl border border-stone-200 bg-white px-4 py-3">
            {badge}
          </span>
        ))}
      </div>
    </div>
    <LeadFormIsland client:visible intent={intent} variant={variant} />
  </div>
</section>
