---
import LeadFormIsland from "./LeadFormIsland";

type LeadFormVariant =
  | "general"
  | "valuation"
  | "relocation"
  | "property_inquiry"
  | "showing_request";

interface Props {
  intent?: string;
  variant?: LeadFormVariant;
  eyebrow?: string;
  title?: string;
  copy?: string;
  badges?: string[];
}

const {
  intent = "general_contact",
  variant = "general",
  eyebrow = "Next step",
  title = "Get a local plan before you make a move.",
  copy = "Send your request through the site first so Joel has the page, intent, property, and timing context before the next conversation.",
  badges = ["Buyer search", "Seller strategy", "Relocation help"],
} = Astro.props;
---

<section class="bg-[var(--brand-warm-ivory)] px-5 py-20">
  <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-[1fr_0.82fr]">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.24em] text-[var(--brand-deep-olive)]">
        {eyebrow}
      </p>

      <h2 class="mt-3 max-w-3xl text-4xl font-bold tracking-[-0.045em] text-[var(--brand-ink)] md:text-5xl">
        {title}
      </h2>

      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-700">
        {copy}
      </p>

      <div class="mt-6 grid gap-3 text-sm font-bold text-[var(--brand-ink)] sm:grid-cols-3">
        {badges.map((badge) => (
          <span class="rounded-2xl border border-[var(--brand-pink-sand)] bg-white/70 px-4 py-3 shadow-sm">
            {badge}
          </span>
        ))}
      </div>
    </div>

    <div class="rounded-[2rem] border border-[var(--brand-pink-sand)] bg-white/75 p-3 shadow-xl shadow-stone-900/5">
      <LeadFormIsland client:visible intent={intent} variant={variant} />
    </div>
  </div>
</section>
