---
import { site } from "@home/config/site";
import { featuredSearches, navItems } from "@home/config/routes";

const footerExploreItems = navItems.filter((item) =>
  ["Search Homes", "Neighborhoods", "Buyers", "Sellers", "Relocation", "Contact"].includes(
    item.label,
  ),
);

const footerResourceItems = navItems.filter((item) =>
  ["Financing Options", "Horse Properties", "Market Guides"].includes(item.label),
);

const legalItems = [
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms", href: "/terms/" },
  { label: "Accessibility", href: "/accessibility/" },
];
---

<footer class="border-t border-[var(--brand-pink-sand)] bg-[var(--brand-ink)] text-[var(--brand-warm-ivory)]">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 md:grid-cols-[1.25fr_0.75fr_0.75fr_0.9fr]">
    <div>
      <div class="flex items-center gap-3">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center">
          <img
            src="/brand/marks/robertson-r-mark-vectorized.svg"
            alt=""
            class="h-10 w-10"
            loading="lazy"
          />
        </span>

        <div class="leading-none">
          <p class="text-base font-bold tracking-[0.18em]">ROBERTSON</p>
          <p class="mt-1 text-xs font-bold tracking-[0.24em] text-[var(--brand-gold)]">
            REAL ESTATE
          </p>
          <p class="mt-1 text-[0.62rem] font-semibold tracking-[0.2em] text-[var(--brand-pink-sand)]">
            SAINT GEORGE, UTAH
          </p>
        </div>
      </div>

      <p class="mt-5 max-w-md text-sm leading-6 text-[var(--brand-pink-sand)]">
        Real estate search, local guidance, and seller strategy for {site.market}.
      </p>

      <div class="mt-4 grid gap-1 text-sm font-semibold text-[var(--brand-warm-ivory)]">
        <a class="w-fit hover:text-[var(--brand-gold)]" href={site.phoneHref}>{site.phone}</a>
        <a class="w-fit hover:text-[var(--brand-gold)]" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>

    <div>
      <p class="font-bold text-[var(--brand-clay)]">Explore</p>
      <div class="mt-4 grid gap-2 text-sm text-[var(--brand-pink-sand)]">
        {footerExploreItems.map((item) => (
          <a class="transition hover:text-[var(--brand-warm-ivory)]" href={item.href}>
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <div>
      <p class="font-bold text-[var(--brand-clay)]">Resources</p>
      <div class="mt-4 grid gap-2 text-sm text-[var(--brand-pink-sand)]">
        {footerResourceItems.map((item) => (
          <a class="transition hover:text-[var(--brand-warm-ivory)]" href={item.href}>
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <div>
      <p class="font-bold text-[var(--brand-clay)]">Featured searches</p>
      <div class="mt-4 grid gap-2 text-sm text-[var(--brand-pink-sand)]">
        {featuredSearches.map((item) => (
          <a class="transition hover:text-[var(--brand-warm-ivory)]" href={item.href}>
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="border-t border-white/10 px-5 py-5 text-center text-xs leading-6 text-[var(--brand-pink-sand)]">
    <p>© {new Date().getFullYear()} {site.companyName}. Equal Housing Opportunity.</p>
    <p class="mx-auto mt-1 max-w-4xl">
      Listing information is believed reliable but not guaranteed. Display requirements and disclaimers are
      controlled by the approved IDX provider and applicable MLS rules.
    </p>
    <nav aria-label="Legal" class="mt-3 flex flex-wrap justify-center gap-x-5 gap-y-2">
      {legalItems.map((item) => (
        <a class="underline-offset-4 hover:text-[var(--brand-warm-ivory)] hover:underline" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
