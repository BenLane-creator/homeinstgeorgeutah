---
const cards = [
  {
    title: "Buyers",
    copy: "Search clearly, compare neighborhoods, and get a plan before touring.",
    href: "/buyers/",
    image: "/brand/portfolio/craftsman-home-entry.webp",
    mode: "cover",
  },
  {
    title: "Sellers",
    copy: "Position the property with sharper presentation, pricing, and launch strategy.",
    href: "/sellers/",
    image: "/brand/portfolio/seller-luxury-home.webp",
    mode: "contain",
  },
  {
    title: "Relocation",
    copy: "Understand lifestyle, schools, terrain, weather, and commute tradeoffs.",
    href: "/relocation/",
    image: "/brand/portfolio/st-george-luxury-evening-home.webp",
    mode: "cover",
  },
];
---

<section class="brand-dark relative overflow-hidden px-5 py-20">
<div class="mx-auto max-w-7xl">
    <p class="brand-eyebrow text-[#edd8cd]">Strategic Guidance</p>
    <h2 class="mt-3 max-w-3xl font-serif text-4xl font-semibold text-white md:text-5xl">
      Clear next steps for every move.
    </h2>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {cards.map((card) => (
        <a href={card.href} class="group overflow-hidden rounded-[1.75rem] bg-white/8 ring-1 ring-white/10 transition hover:bg-white hover:text-[#1c1917]">
          <div class="h-52 overflow-hidden bg-[#f5f0e8]">
            <img
              src={card.image}
              alt=""
              class:list={[
                "h-full w-full transition duration-300 group-hover:scale-[1.02]",
                card.mode === "contain" ? "object-contain p-5" : "object-cover",
              ]}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-7">
            <h3 class="font-serif text-3xl font-semibold">{card.title}</h3>
            <p class="mt-4 text-sm leading-6 opacity-80">{card.copy}</p>
            <span class="mt-6 inline-flex font-bold uppercase tracking-[0.14em] text-[#edd8cd] group-hover:text-[#7A8B75]">Learn more →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
