---
const primaryNavItems = [
  { label: "Search Homes", href: "/homes/search/" },
  { label: "Neighborhoods", href: "/neighborhoods/" },
  { label: "Buyers", href: "/buyers/" },
  { label: "Sellers", href: "/sellers/" },
  { label: "Financing Options", href: "/seller-financing/" },
  { label: "Relocation", href: "/relocation/" },
  { label: "Resources", href: "/blog/" },
];

const moreNavItems = [
  { label: "About", href: "/about/" },
  { label: "Horse Properties", href: "/horse-properties/" },
  { label: "Contact", href: "/contact/" },
];
---

<header class="sticky top-0 z-50 border-b border-[#e3d8ca]/80 bg-[#fffaf3]/94 backdrop-blur-xl">
  <div class="mx-auto flex min-h-[58px] max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-5 lg:min-h-16">
    <a href="/" class="flex min-h-10 items-center" aria-label="Robertson Real Estate home">
      <img
        src="/brand/logos/robertson-logo-lockup-transparent.webp"
        alt="Robertson Real Estate"
        class="h-9 w-auto max-w-[210px] sm:h-10 sm:max-w-[240px] lg:h-11 lg:max-w-[270px]"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="hidden items-center gap-4 text-[0.66rem] font-bold uppercase tracking-[0.13em] text-[#4f4942] xl:flex" aria-label="Primary navigation">
      {primaryNavItems.map((item) => (
        <a class="transition hover:text-[#1c1917]" href={item.href}>{item.label}</a>
      ))}

      <div class="relative" data-more-menu>
        <button
          type="button"
          class="text-[0.66rem] font-bold uppercase tracking-[0.13em] transition hover:text-[#1c1917]"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="desktop-more-menu"
          data-more-button
        >
          More
        </button>

        <div
          id="desktop-more-menu"
          class="pointer-events-none invisible absolute right-0 top-full z-50 min-w-56 pt-3 opacity-0 transition duration-150"
          data-more-panel
        >
          <div class="grid gap-2 rounded-2xl border border-[#e3d8ca] bg-[#fffaf3] p-3 shadow-[0_18px_50px_rgba(28,25,23,0.14)]">
            {moreNavItems.map((item) => (
              <a
                class="rounded-xl px-3 py-2 transition hover:bg-[#f5f0e8] hover:text-[#1c1917]"
                href={item.href}
                data-more-link
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/homes/search/" class="hidden rounded-full border border-[#d8c8b8] bg-white/72 px-4 py-2.5 text-[0.66rem] font-bold uppercase tracking-[0.13em] text-[#1c1917] shadow-sm transition hover:bg-[#f5f0e8] sm:inline-flex">
        Search
      </a>
      <a href="/contact/" class="rounded-full bg-[#1c1917] px-4 py-2.5 text-[0.66rem] font-bold uppercase tracking-[0.13em] text-white shadow-sm transition hover:bg-[#302b27]">
        Contact
      </a>
    </div>
  </div>
</header>

<script>
  const moreMenus = document.querySelectorAll("[data-more-menu]");

  for (const menu of moreMenus) {
    const button = menu.querySelector("[data-more-button]");
    const panel = menu.querySelector("[data-more-panel]");
    const links = menu.querySelectorAll("[data-more-link]");

    if (!button || !panel) continue;

    let closeTimer;

    const openMenu = () => {
      window.clearTimeout(closeTimer);
      button.setAttribute("aria-expanded", "true");
      panel.classList.remove("invisible", "opacity-0", "pointer-events-none");
      panel.classList.add("visible", "opacity-100", "pointer-events-auto");
    };

    const closeMenu = () => {
      window.clearTimeout(closeTimer);
      button.setAttribute("aria-expanded", "false");
      panel.classList.add("invisible", "opacity-0", "pointer-events-none");
      panel.classList.remove("visible", "opacity-100", "pointer-events-auto");
    };

    const closeMenuSoon = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(closeMenu, 120);
    };

    const toggleMenu = (event) => {
      event.stopPropagation();

      if (button.getAttribute("aria-expanded") === "true") {
        closeMenu();
      } else {
        openMenu();
      }
    };

    menu.addEventListener("mouseenter", openMenu);
    menu.addEventListener("mouseleave", closeMenuSoon);
    menu.addEventListener("focusin", openMenu);
    menu.addEventListener("focusout", () => {
      window.setTimeout(() => {
        if (!menu.contains(document.activeElement)) {
          closeMenu();
        }
      }, 0);
    });

    button.addEventListener("click", toggleMenu);

    for (const link of links) {
      link.addEventListener("click", closeMenu);
    }

    document.addEventListener("pointerdown", (event) => {
      if (!menu.contains(event.target)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        closeMenu();
        button.focus();
      }
    });
  }
</script>
