---
import { site } from "@home/config/site";
import { navItems } from "@home/config/routes";
---

<header class="sticky top-0 z-50 border-b border-stone-200/70 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4">
    <a href="/" class="font-serif text-xl font-semibold tracking-tight text-stone-950">
      {site.name}
    </a>

    <nav class="hidden items-center gap-5 text-sm font-medium text-stone-700 lg:flex">
      {navItems.slice(0, 7).map((item) => (
        <a class="hover:text-stone-950" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={site.phoneHref} class="text-sm font-semibold text-stone-700 hover:text-stone-950">
        {site.phone}
      </a>

      <a
        href="/contact/"
        class="rounded-full bg-stone-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-stone-800"
      >
        Contact
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary class="list-none rounded-full border border-stone-200 px-4 py-2 text-sm font-semibold text-stone-800">
        Menu
      </summary>

      <div class="absolute right-0 mt-3 w-72 rounded-3xl border border-stone-200 bg-white p-4 shadow-xl">
        <nav class="grid gap-1">
          {navItems.map((item) => (
            <a
              class="rounded-2xl px-4 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50 hover:text-stone-950"
              href={item.href}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="mt-4 border-t border-stone-200 pt-4">
          <a
            href={site.phoneHref}
            class="block rounded-2xl bg-[#fffaf3] px-4 py-3 text-sm font-semibold text-stone-800"
          >
            Call {site.phone}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
