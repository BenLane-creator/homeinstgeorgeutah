---
import { site } from "@home/config/site";
import { navItems } from "@home/config/routes";

const primaryNavItems = navItems.filter((item) =>
  ["Search Homes", "Neighborhoods", "Buyers", "Sellers", "About"].includes(item.label),
);

const resourceNavItems = navItems.filter((item) =>
  ["Relocation", "Financing Options", "Horse Properties", "Blog"].includes(item.label),
);
---

<header class="sticky top-0 z-[60] border-b border-[var(--brand-pink-sand)] bg-[var(--brand-warm-ivory)] shadow-sm shadow-stone-950/5">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-5 lg:py-4">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label={`${site.name} home`}>
      <span class="flex h-11 w-11 shrink-0 items-center justify-center">
        <img
          src="/brand/marks/robertson-r-mark-vectorized.svg"
          alt=""
          class="h-9 w-9"
          loading="eager"
        />
      </span>

      <span class="hidden h-10 w-px shrink-0 bg-[var(--brand-clay)] sm:block"></span>

      <span class="min-w-0 leading-none">
        <span class="block font-heading text-[0.92rem] font-semibold tracking-[0.18em] text-[var(--brand-ink)] sm:text-base">
          ROBERTSON
        </span>
        <span class="mt-1 block text-[0.64rem] font-bold tracking-[0.24em] text-[var(--brand-gold)] sm:text-[0.68rem]">
          REAL ESTATE
        </span>
        <span class="mt-1 hidden text-[0.55rem] font-semibold tracking-[0.2em] text-stone-500 sm:block">
          SAINT GEORGE, UTAH
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-5 text-sm font-semibold text-stone-700 lg:flex" aria-label="Primary navigation">
      {primaryNavItems.map((item) => (
        <a class="transition hover:text-[var(--brand-ink)]" href={item.href}>
          {item.label}
        </a>
      ))}

      <div class="relative" data-resources-menu>
        <button
          type="button"
          class="flex items-center gap-1 transition hover:text-[var(--brand-ink)]"
          aria-expanded="false"
          aria-controls="resources-menu-panel"
          data-resources-button
        >
          Resources
          <span class="text-[0.65rem] text-[var(--brand-gold)] transition" data-resources-caret>
            ▾
          </span>
        </button>

        <div
          id="resources-menu-panel"
          class="absolute left-1/2 top-full z-[70] mt-4 w-64 -translate-x-1/2 rounded-3xl border border-[var(--brand-pink-sand)] bg-[var(--brand-warm-ivory)] p-3 shadow-2xl shadow-stone-950/10"
          data-resources-panel
          hidden
        >
          <nav class="grid gap-1" aria-label="Resources navigation">
            {resourceNavItems.map((item) => (
              <a
                class="rounded-2xl px-4 py-3 text-sm font-semibold text-stone-700 transition hover:bg-white hover:text-[var(--brand-ink)]"
                href={item.href}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={site.phoneHref}
        class="text-sm font-semibold text-stone-700 transition hover:text-[var(--brand-ink)]"
      >
        {site.phone}
      </a>

      <a
        href="/contact/?intent=general_contact"
        class="rounded-full bg-[var(--brand-ink)] px-5 py-2.5 text-sm font-bold text-[var(--brand-warm-ivory)] shadow-sm transition hover:bg-[var(--brand-deep-olive)]"
      >
        Contact
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary class="list-none rounded-full border border-[var(--brand-pink-sand)] bg-white/70 px-4 py-2 text-sm font-bold text-[var(--brand-ink)]">
        Menu
      </summary>

      <div class="absolute right-0 mt-3 max-h-[calc(100svh-6rem)] w-72 overflow-y-auto rounded-3xl border border-[var(--brand-pink-sand)] bg-[var(--brand-warm-ivory)] p-4 shadow-xl">
        <nav class="grid gap-1" aria-label="Mobile navigation">
          {primaryNavItems.map((item) => (
            <a
              class="rounded-2xl px-4 py-3 text-sm font-semibold text-stone-700 transition hover:bg-white hover:text-[var(--brand-ink)]"
              href={item.href}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="mt-4 border-t border-[var(--brand-pink-sand)] pt-4">
          <p class="px-4 text-[0.65rem] font-bold uppercase tracking-[0.24em] text-[var(--brand-deep-olive)]">
            Resources
          </p>

          <nav class="mt-2 grid gap-1" aria-label="Mobile resources navigation">
            {resourceNavItems.map((item) => (
              <a
                class="rounded-2xl px-4 py-3 text-sm font-semibold text-stone-700 transition hover:bg-white hover:text-[var(--brand-ink)]"
                href={item.href}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        <div class="mt-4 grid gap-2 border-t border-[var(--brand-pink-sand)] pt-4">
          <a
            href={site.phoneHref}
            class="block rounded-2xl bg-white px-4 py-3 text-sm font-bold text-[var(--brand-ink)] ring-1 ring-[var(--brand-clay)]"
          >
            Call {site.phone}
          </a>

          <a
            href="/contact/?intent=general_contact"
            class="block rounded-2xl bg-[var(--brand-ink)] px-4 py-3 text-sm font-bold text-[var(--brand-warm-ivory)]"
          >
            Contact Joel
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-resources-menu]");
    if (!root) return;

    const button = root.querySelector("[data-resources-button]");
    const panel = root.querySelector("[data-resources-panel]");
    const caret = root.querySelector("[data-resources-caret]");
    const links = panel?.querySelectorAll("a") ?? [];

    if (!button || !panel) return;

    const setOpen = (open) => {
      button.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      caret?.classList.toggle("rotate-180", open);
    };

    button.addEventListener("click", () => {
      setOpen(panel.hidden);
    });

    button.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setOpen(true);
        links[0]?.focus();
      }

      if (event.key === "Escape") {
        setOpen(false);
        button.focus();
      }
    });

    panel.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
        button.focus();
      }
    });

    links.forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("click", (event) => {
      if (!root.contains(event.target)) {
        setOpen(false);
      }
    });
  })();
</script>
